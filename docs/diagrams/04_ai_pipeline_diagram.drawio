<mxfile host="drawio"><diagram name="Knowledge tracing pipeline" id="Knowledge tracing pi"><mxGraphModel dx="1640" dy="640" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1640" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s0" value="&lt;b&gt;Source: quiz_interactions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f0fa;strokeColor=#6b46c1;fontSize=15;align=center;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="600" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Stage 1: Interaction sequence&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#2b6cb0;fontSize=15;align=center;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="300" height="600" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Stage 2: Encoding&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#2f855a;fontSize=15;align=center;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="20" width="300" height="600" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Stage 3: Knowledge tracing models&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8eb;strokeColor=#c47f00;fontSize=15;align=center;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1010" y="20" width="300" height="600" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Stage 4: Output to the LMS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdeff0;strokeColor=#c53030;fontSize=15;align=center;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1340" y="20" width="300" height="600" as="geometry"/></mxCell><mxCell id="s0b0" value="&lt;b&gt;One row per submitted answer&lt;/b&gt;&lt;br&gt;user_id, session_id,&lt;br&gt;question_id, skill_id,&lt;br&gt;is_correct, attempt_count,&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b46c1;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="35" y="70" width="270" height="160" as="geometry"/></mxCell><mxCell id="s0b1" value="&lt;b&gt;Written by POST /api/quizzes/:id/submit&lt;/b&gt;&lt;br&gt;inside one transaction;&lt;br&gt;skill_id is copied from&lt;br&gt;the question" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b46c1;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="35" y="250" width="270" height="160" as="geometry"/></mxCell><mxCell id="s0b2" value="&lt;b&gt;Export&lt;/b&gt;&lt;br&gt;ordered by user_id, then&lt;br&gt;created_at; retakes stay as&lt;br&gt;new rows (attempt_count + 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b46c1;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="35" y="430" width="270" height="160" as="geometry"/></mxCell><mxCell id="s1b0" value="&lt;b&gt;Interaction x_t = (q_t, s_t, a_t)&lt;/b&gt;&lt;br&gt;q_t: question&lt;br&gt;s_t: skill (K = 11 for CO2003)&lt;br&gt;a_t = 1 if correct, else 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b6cb0;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="365" y="70" width="270" height="160" as="geometry"/></mxCell><mxCell id="s1b1" value="&lt;b&gt;Sequence per student&lt;/b&gt;&lt;br&gt;X = (x_1, …, x_T)&lt;br&gt;strict time order" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b6cb0;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="365" y="250" width="270" height="160" as="geometry"/></mxCell><mxCell id="s1b2" value="&lt;b&gt;Split&lt;/b&gt;&lt;br&gt;by student (no student in&lt;br&gt;both training and test)&lt;br&gt;5 folds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b6cb0;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="365" y="430" width="270" height="160" as="geometry"/></mxCell><mxCell id="s2b0" value="&lt;b&gt;One-hot of size 2K&lt;/b&gt;&lt;br&gt;index = s_t + K · a_t&lt;br&gt;K = 11 gives 22 inputs&lt;br&gt;separates trying a skill&lt;br&gt;from answering it correctly" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f855a;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="695" y="70" width="270" height="160" as="geometry"/></mxCell><mxCell id="s2b1" value="&lt;b&gt;Padding and masking&lt;/b&gt;&lt;br&gt;sequences cut or padded&lt;br&gt;to a fixed length; padded&lt;br&gt;steps are masked in the loss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f855a;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="695" y="250" width="270" height="160" as="geometry"/></mxCell><mxCell id="s2b2" value="&lt;b&gt;Next-step target&lt;/b&gt;&lt;br&gt;predict a_(t+1) for skill&lt;br&gt;s_(t+1) from x_1 … x_t" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f855a;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="695" y="430" width="270" height="160" as="geometry"/></mxCell><mxCell id="s3b0" value="&lt;b&gt;BKT baseline (implemented)&lt;/b&gt;&lt;br&gt;HMM per skill:&lt;br&gt;P(L0), P(T), P(G), P(S)&lt;br&gt;used by /predict-mastery" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c47f00;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1025" y="70" width="270" height="160" as="geometry"/></mxCell><mxCell id="s3b1" value="&lt;b&gt;DKT (planned)&lt;/b&gt;&lt;br&gt;h_t = LSTM(x_t, h_(t-1))&lt;br&gt;y_t = σ(W · h_t + b) ∈ [0,1]^K&lt;br&gt;loss: binary cross-entropy&lt;br&gt;on the next answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c47f00;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;dashed=1;" vertex="1" parent="1"><mxGeometry x="1025" y="250" width="270" height="160" as="geometry"/></mxCell><mxCell id="s3b2" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;AUC and accuracy, BKT vs DKT&lt;br&gt;ASSISTments 2009-2010&lt;br&gt;and CO2003 data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c47f00;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1025" y="430" width="270" height="160" as="geometry"/></mxCell><mxCell id="s4b0" value="&lt;b&gt;Mastery level per skill&lt;/b&gt;&lt;br&gt;≥ 0.75  Mastered&lt;br&gt;0.50 – 0.75  Developing&lt;br&gt;&amp;lt; 0.50  Needs review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c53030;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1355" y="70" width="270" height="160" as="geometry"/></mxCell><mxCell id="s4b1" value="&lt;b&gt;Competency chart (UC4)&lt;/b&gt;&lt;br&gt;radar of the 11 skills for&lt;br&gt;the student; class view&lt;br&gt;for the lecturer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c53030;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1355" y="250" width="270" height="160" as="geometry"/></mxCell><mxCell id="s4b2" value="&lt;b&gt;Remedial practice&lt;/b&gt;&lt;br&gt;point to the sessions that&lt;br&gt;teach the weak skill and to&lt;br&gt;unanswered questions of&lt;br&gt;that skill" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c53030;fontSize=13;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1355" y="430" width="270" height="160" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
