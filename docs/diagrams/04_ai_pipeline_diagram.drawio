    <mxCell id="st4_c1" value="1. Mastery Classification&#xa;• y_t ≥ 0.75: Mastered&#xa;• 0.50 ≤ y_t &lt; 0.75: Developing&#xa;• y_t &lt; 0.50: Needs Remediation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=12;fontStyle=0;fontSize=11.5;" vertex="1" parent="st4">
      <mxGeometry x="20" y="60" width="310" height="165" as="geometry" />
    </mxCell>
    <mxCell id="st4_c2" value="2. Competency Radar Chart&#xa;• Multi-axis dynamic radar&#xa;• Real-time mastery visualizer&#xa;• Self-regulated learning feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=12;fontStyle=0;fontSize=11.5;" vertex="1" parent="st4">
      <mxGeometry x="20" y="250" width="310" height="155" as="geometry" />
    </mxCell>
    <mxCell id="st4_c3" value="3. Remedial Lecture Links&#xa;• Auto-recommends review lessons&#xa;• Directly targets weak skill_ids&#xa;• Closes learning loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=12;fontStyle=0;fontSize=11.5;" vertex="1" parent="st4">
      <mxGeometry x="20" y="430" width="310" height="145" as="geometry" />
