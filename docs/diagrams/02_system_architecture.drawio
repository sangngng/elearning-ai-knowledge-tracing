<mxfile host="drawio"><diagram name="System architecture" id="System architecture"><mxGraphModel dx="1400" dy="1060" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Tier 1: Presentation  |  Next.js 14 (React), port 3000&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#2b6cb0;fontSize=15;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1360" height="230" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Tier 2: REST API  |  Express 5 + TypeScript, port 8080&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#2f855a;fontSize=15;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1360" height="270" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;Tier 3: Persistence  |  PostgreSQL 15 (14 tables, 3NF), port 5432&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f0fa;strokeColor=#6b46c1;fontSize=15;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="1360" height="240" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;Tier 4: AI service  |  FastAPI + PyTorch, port 8000, called by Tier 2 over HTTP JSON (planned)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8eb;strokeColor=#c47f00;fontSize=15;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="890" width="1360" height="150" as="geometry"/></mxCell><mxCell id="fe_s" value="&lt;b&gt;Student views&lt;/b&gt;&lt;br&gt;• Login (HCMUT account) and role from the API&lt;br&gt;• Home, My courses: classes from GET /api/classes&lt;br&gt;• Course: 15 sessions, timetable with periods&lt;br&gt;• Attendance: enter 4-digit PIN (2 attempts)&lt;br&gt;• Session quiz with server-side grading" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b6cb0;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="50" y="60" width="420" height="175" as="geometry"/></mxCell><mxCell id="fe_l" value="&lt;b&gt;Lecturer views&lt;/b&gt;&lt;br&gt;• Open / close attendance PIN (1 minute)&lt;br&gt;• Roster: manual status present / late /&lt;br&gt;  absent / excused&lt;br&gt;• Attendance statistics per student and session&lt;br&gt;• Same course, session and timetable pages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b6cb0;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="420" height="175" as="geometry"/></mxCell><mxCell id="fe_c" value="&lt;b&gt;Shared client layer&lt;/b&gt;&lt;br&gt;• lib/api.js: one fetch wrapper, JSON errors&lt;br&gt;• Bearer token kept in sessionStorage&lt;br&gt;• 401 returns the user to the login screen&lt;br&gt;• NEXT_PUBLIC_API_URL selects the backend&lt;br&gt;• BKeL look: #008299, Moodle SVG icons" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b6cb0;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="930" y="60" width="420" height="175" as="geometry"/></mxCell><mxCell id="be_m" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;• CORS allow-list (CORS_ORIGINS)&lt;br&gt;• JSON body limit 1 MB&lt;br&gt;• authenticate: verify JWT (1 day)&lt;br&gt;• requireRoles(student | instructor&lt;br&gt;  | admin)&lt;br&gt;• Central error handler (no stack&lt;br&gt;  traces to clients)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f855a;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="300" height="215" as="geometry"/></mxCell><mxCell id="be_a" value="&lt;b&gt;routes/auth&lt;/b&gt;&lt;br&gt;POST /api/auth/register&lt;br&gt;POST /api/auth/login&lt;br&gt;&lt;br&gt;bcrypt (cost 12)&lt;br&gt;e-mail is case-insensitive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f855a;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="370" y="340" width="240" height="215" as="geometry"/></mxCell><mxCell id="be_c" value="&lt;b&gt;routes/academic&lt;/b&gt;&lt;br&gt;GET  /api/me, /api/classes, /api/schedule&lt;br&gt;GET  /api/classes/:id/sessions&lt;br&gt;POST /api/classes/:id/sessions (and /bulk)&lt;br&gt;POST /api/classes/:id/enrollments/import&lt;br&gt;POST /api/sessions/:id/attendance/open | close&lt;br&gt;POST /api/sessions/:id/attendance/check-in&lt;br&gt;PUT  /api/sessions/:id/attendance/:userId&lt;br&gt;GET  /api/classes/:id/attendance/summary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f855a;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="630" y="340" width="440" height="215" as="geometry"/></mxCell><mxCell id="be_q" value="&lt;b&gt;routes/quizzes&lt;/b&gt;&lt;br&gt;GET  /api/sessions/:id/quizzes&lt;br&gt;POST /api/quizzes/:id/submit&lt;br&gt;&lt;br&gt;Answer key never sent&lt;br&gt;One quiz_interactions row&lt;br&gt;per answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f855a;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1090" y="340" width="260" height="215" as="geometry"/></mxCell><mxCell id="db1" value="&lt;b&gt;Accounts and academic&lt;/b&gt;&lt;br&gt;users&lt;br&gt;semesters&lt;br&gt;courses&lt;br&gt;course_classes&lt;br&gt;enrollments" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b46c1;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="50" y="650" width="250" height="185" as="geometry"/></mxCell><mxCell id="db2" value="&lt;b&gt;Sessions and attendance&lt;/b&gt;&lt;br&gt;course_sessions&lt;br&gt;session_materials&lt;br&gt;attendance_records&lt;br&gt;attendance_pin_attempts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b46c1;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="320" y="650" width="250" height="185" as="geometry"/></mxCell><mxCell id="db3" value="&lt;b&gt;Assessment (AI input)&lt;/b&gt;&lt;br&gt;skills&lt;br&gt;quizzes&lt;br&gt;questions&lt;br&gt;quiz_interactions&lt;br&gt;schema_version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b46c1;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="590" y="650" width="250" height="185" as="geometry"/></mxCell><mxCell id="db4" value="&lt;b&gt;Integrity rules in the database&lt;/b&gt;&lt;br&gt;• Capacity trigger with SELECT … FOR UPDATE&lt;br&gt;• PIN: 4 random digits, valid 1 to 15 minutes, compared&lt;br&gt;  in constant time; hidden from students&lt;br&gt;• At most 2 wrong PIN attempts per student and session&lt;br&gt;  (pg_advisory_xact_lock serialises check-ins)&lt;br&gt;• One attendance record per (session, student)&lt;br&gt;• (question_id, skill_id) foreign key keeps skill labels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b46c1;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="860" y="650" width="490" height="185" as="geometry"/></mxCell><mxCell id="ai1" value="&lt;b&gt;Inference API&lt;/b&gt;&lt;br&gt;GET /health&lt;br&gt;POST /predict-mastery (interactions per skill)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c47f00;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="50" y="930" width="400" height="95" as="geometry"/></mxCell><mxCell id="ai2" value="&lt;b&gt;Knowledge tracing&lt;/b&gt;&lt;br&gt;BKT baseline (implemented)&lt;br&gt;DKT with LSTM (planned, Sprint 4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c47f00;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="470" y="930" width="420" height="95" as="geometry"/></mxCell><mxCell id="ai3" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;ASSISTments 2009-2010 and CO2003 interactions&lt;br&gt;AUC and accuracy, student-split 5-fold" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c47f00;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="910" y="930" width="440" height="95" as="geometry"/></mxCell><mxCell id="e0" value="HTTP JSON, Authorization: Bearer &amp;lt;JWT&amp;gt;" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="node-postgres pool: parameterised SQL, transactions" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
