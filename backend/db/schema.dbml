Project elearning_ai_v2 {
  database_type: 'PostgreSQL'
  Note: 'v2 academic schedule, class enrollment, attendance PIN, and per-session quiz telemetry schema'
}

Enum user_role {
  student
  instructor
  admin
}

Enum lesson_content_type {
  video
  document
  text
}

Table users {
  id uuid [pk]
  name varchar(120) [not null]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  role user_role [not null, default: 'student']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table semesters {
  id uuid [pk]
  code varchar(20) [not null, unique, note: 'Example: HK261']
  name varchar(160) [not null]
  start_date date [not null]
  end_date date [not null]
  is_active boolean [not null, default: false, note: 'Partial unique index permits at most one active semester']
  created_at timestamptz [not null]
}

Table courses {
  id uuid [pk]
  instructor_id uuid [not null]
  title varchar(200) [not null]
  description text
  is_published boolean [not null, default: false]
  created_at timestamptz [not null]
}

Table course_classes {
  id uuid [pk]
  course_id uuid [not null]
  semester_id uuid [not null]
  class_code varchar(40) [not null]
  instructor_id uuid [not null]
  max_capacity int [not null, default: 60]
  default_room varchar(80)
  created_at timestamptz [not null]

  indexes {
    (semester_id, class_code) [unique]
    (course_id, semester_id)
  }
}

Table enrollments {
  id uuid [pk]
  class_id uuid [not null]
  user_id uuid [not null]
  status varchar(16) [not null, default: 'enrolled', note: 'enrolled | dropped']
  enrolled_at timestamptz [not null]
  final_grade numeric(5,2)

  indexes {
    (class_id, user_id) [unique]
    (class_id, status)
    (user_id, status)
  }
}

Table course_sessions {
  id uuid [pk]
  class_id uuid [not null]
  session_number smallint [not null, note: '1 through 15']
  title varchar(200) [not null]
  session_date date [not null]
  start_time time [not null]
  end_time time [not null]
  room varchar(80)
  attendance_code varchar(4) [note: 'Four numeric digits; null while closed']
  is_attendance_open boolean [not null, default: false]
  attendance_expires_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (class_id, session_number) [unique]
    (class_id, session_date, start_time)
  }
}

Table session_materials {
  id uuid [pk]
  session_id uuid [not null]
  title varchar(200) [not null]
  material_type varchar(16) [not null, note: 'slide | code | video']
  file_url text [not null]
  position int [not null, default: 1]
  created_at timestamptz [not null]

  indexes {
    (session_id, position) [unique]
  }
}

Table attendance_records {
  id uuid [pk]
  session_id uuid [not null]
  user_id uuid [not null]
  status varchar(16) [not null, note: 'present | absent | late | excused']
  checkin_time timestamptz
  method varchar(16) [note: 'pin | qr | manual']
  note text
  created_at timestamptz [not null]

  indexes {
    (session_id, user_id) [unique]
    (user_id, session_id)
  }
}

Table attendance_pin_attempts {
  id uuid [pk]
  session_id uuid [not null]
  user_id uuid [not null]
  attempted_at timestamptz [not null]
  succeeded boolean [not null]
}

Table quizzes {
  id uuid [pk]
  lesson_id uuid [note: 'Nullable legacy link retained for v1 quizzes']
  session_id uuid [not null, note: 'Each v2 quiz belongs to a class session']
  title varchar(200) [not null]
  is_published boolean [not null, default: false]
  created_at timestamptz [not null]
}

Table skills {
  id uuid [pk]
  code varchar(80) [not null, unique, note: 'Example: DSA-LINKEDLIST']
  name varchar(200) [not null]
  description text
  created_at timestamptz [not null]
}

Table questions {
  id uuid [pk]
  quiz_id uuid [not null]
  skill_id uuid [not null]
  prompt text [not null]
  options jsonb [not null]
  correct_answer text [not null, note: 'Server-only answer key; excluded from learner responses']
  position int [not null]

  indexes {
    (quiz_id, position) [unique]
    (id, skill_id) [unique]
  }
}

Table quiz_interactions {
  id uuid [pk]
  user_id uuid [not null]
  session_id uuid [not null, note: 'Direct link for session-level AI telemetry']
  question_id uuid [not null]
  skill_id uuid [not null]
  is_correct boolean [not null]
  attempt_count int [not null]
  created_at timestamptz [not null]

  indexes {
    (user_id, skill_id, created_at)
    (session_id, user_id, created_at)
    (user_id, question_id, attempt_count)
  }
}

Table lessons {
  Note: 'Legacy v1 content table retained for existing lesson API/data.'
  id uuid [pk]
  course_id uuid [not null]
  title varchar(200) [not null]
  description text
  content_type lesson_content_type [not null]
  content_url text
  position int [not null]
  created_at timestamptz [not null]
}

Ref: courses.instructor_id > users.id [delete: restrict]
Ref: course_classes.course_id > courses.id [delete: cascade]
Ref: course_classes.semester_id > semesters.id [delete: restrict]
Ref: course_classes.instructor_id > users.id [delete: restrict]
Ref: enrollments.class_id > course_classes.id [delete: cascade]
Ref: enrollments.user_id > users.id [delete: cascade]
Ref: course_sessions.class_id > course_classes.id [delete: cascade]
Ref: session_materials.session_id > course_sessions.id [delete: cascade]
Ref: attendance_records.session_id > course_sessions.id [delete: cascade]
Ref: attendance_records.user_id > users.id [delete: cascade]
Ref: attendance_pin_attempts.session_id > course_sessions.id [delete: cascade]
Ref: attendance_pin_attempts.user_id > users.id [delete: cascade]
Ref: quizzes.lesson_id > lessons.id [delete: set null]
Ref: quizzes.session_id > course_sessions.id [delete: cascade]
Ref: questions.quiz_id > quizzes.id [delete: cascade]
Ref: questions.skill_id > skills.id [delete: restrict]
Ref: quiz_interactions.user_id > users.id [delete: cascade]
Ref: quiz_interactions.session_id > course_sessions.id [delete: cascade]
Ref: quiz_interactions.question_id > questions.id [delete: cascade]
Ref: quiz_interactions.skill_id > skills.id [delete: restrict]
Ref: quiz_interactions.(question_id, skill_id) > questions.(id, skill_id) [delete: cascade]
Ref: lessons.course_id > courses.id [delete: cascade]
